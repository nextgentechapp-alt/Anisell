# Firebase Configuration (hardcoded in src/services/firebase/config.ts)
# Vercel env vars needed:
#   VITE_ADMIN_EMAILS=anisellns27@gmail.com
#   VITE_ENABLE_MOCK_DATA=false

CLOUDINARY_UPLOAD_PRESET=preset_name
CLOUDINARY_API_CLOUD_NAME=cloud_name
CLOUDINARY_API=cloudnary_api
CLOUDINARY_API_SECRET=cloudnary_api_secret

# Other App Configuration
VITE_APP_NAME="AniSell"
VITE_ENABLE_MOCK_DATA=false

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# Vercel env for API route: RAZORPAY_KEY_SECRET=xxxxxxxxxx

# WhatsApp Notifications (for admin — Indian number, include +91)
VITE_ADMIN_PHONE=+916380137032

# Email Notifications (EmailJS - optional)
VITE_EMAILJS_SERVICE_ID=service_xxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxx
VITE_EMAILJS_USER_ID=user_xxxxx

# UPI ID for manual payments
STORE_UPI_ID=anisell@upi

# Webhook for notification server (optional)
VITE_ENABLE_WEBHOOK=false
